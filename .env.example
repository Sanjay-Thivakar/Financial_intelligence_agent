# Environment Configuration Template for Financial Intelligence Agent

# 1. Tiingo API (Market Data & Curated News)
# Sign up for a free API token at: https://api.tiingo.com/
TIINGO_API_KEY=your_tiingo_api_key_here

# 2. SEC EDGAR API (Filings, 10-K/10-Q XBRL Facts, 8-K Exhibits)
# Required by SEC fair-access policy: "ProjectName ContactName contact@domain.com"
SEC_USER_AGENT=FinancialIntelligenceResearchProject/1.0 (academic_research@university.edu)

# 3. Finnhub API (Optional Supplementary Real-time News)
# Sign up for a free API token at: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here
